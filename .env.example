# Ledgerly does not need environment variables for the happy path.
# Prisma SQLite is file:./dev.db relative to prisma/schema.prisma.
# Copy this file only if you add a secret later — never commit one.

# Cloud Agents + Automations demo (npm run demo:cloud). Copy to .env.local.
# The Jira project must be dedicated to this demo: reset deletes every issue in it.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=LED
# Your fork, never the shared upstream.
DEMO_GITHUB_REPO=your-github-user/ce-field-demos
DEMO_BASELINE_TAG=demo-baseline
